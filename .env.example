# --- Base de données (PostgreSQL 16) ---
DATABASE_URL=postgres://postgres@localhost:5432/jobpilot
# Base utilisée par les tests d'intégration (vidée à chaque test)
DATABASE_URL_TEST=postgres://postgres@localhost:5432/jobpilot_test

# --- Développement en HTTP uniquement : autorise le cookie de session sans l'attribut Secure ---
# COOKIE_INSECURE=1

# --- Documents ---
# Dossier du stockage local (développement). En production : stockage S3 compatible.
STORAGE_DIR=.data/storage

# --- IA : fournisseurs (voir docs/DECISIONS/0006) ---
# Ordre d'essai. Par défaut : local, groq, cerebras, gemini, mistral, openrouter, anthropic.
# Un fournisseur n'est actif que si sa clé ET son modèle sont renseignés. Vérifier avec : npm run llm:check
# LLM_PROVIDERS=groq,openrouter,gemini

# Pour chaque fournisseur <P> (GROQ, OPENROUTER, GEMINI, MISTRAL, CEREBRAS, LOCAL, ANTHROPIC) :
#   <P>_API_KEY, <P>_MODEL (obligatoires ; aucun modèle par défaut : les modèles gratuits changent souvent)
#   <P>_RPM, <P>_RPD           limites par minute / par jour (0 = aucune) ; valeurs par défaut indicatives
#   <P>_ALLOW_PERSONAL_DATA    true pour autoriser l'envoi du CV et des candidatures (refusé par défaut, sauf LOCAL)
#   <P>_BASE_URL               remplace l'URL par défaut
#   <P>_JSON_MODE              json_schema (défaut, repli automatique) ou json_object
#   <P>_MAX_TOKENS             plafond de sortie (défaut 4096)
#   <P>_PRICE_INPUT_PER_MTOK / <P>_PRICE_OUTPUT_PER_MTOK   tarif USD par million de jetons (défaut 0 : gratuit)

# Groq — https://console.groq.com (exemple de modèle : à vérifier dans la console)
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter — https://openrouter.ai (modèles gratuits : identifiants se terminant par « :free »)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# deny : n'utiliser que des hébergeurs qui ne conservent pas les requêtes (peut exclure des modèles gratuits)
# OPENROUTER_DATA_COLLECTION=deny

# Google Gemini (offre gratuite : contenus utilisés pour améliorer les produits Google)
GEMINI_API_KEY=
GEMINI_MODEL=

# Mistral La Plateforme (offre Experiment : accord pour l'entraînement requis)
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Modèle local compatible OpenAI (Ollama, LM Studio) : les données restent sur ta machine
# LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=

# Anthropic Claude (payant)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Budget journalier des appels payants, en USD (les appels sont bloqués une fois atteint)
LLM_DAILY_BUDGET_USD=2

# Tableau de bord et relances : fuseau des jours (« aujourd'hui », relance en retard) et objectif quotidien d'offres traitées.
APP_TIME_ZONE=Europe/Paris

# Worker : intervalle de relève des files (secondes, 0,5 minimum) et tâches en parallèle par file.
WORKER_POLL_SECONDS=0.5
WORKER_CONCURRENCY=2
JOBPILOT_DAILY_GOAL=20

# --- Sources connectées (docs/DECISIONS/0011) ---
# Clé de chiffrement des identifiants des sources (clés d'API, mot de passe d'application IMAP) : 32 octets en base64.
# Génération : openssl rand -base64 32. La perdre impose de ressaisir les identifiants des sources.
JOBPILOT_SECRETS_KEY=
# Adresses des API, à remplacer seulement derrière un proxy (ou pour les tests) :
# FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
# FRANCE_TRAVAIL_API_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
# ADZUNA_API_URL=https://api.adzuna.com/v1/api/jobs/fr
# Identifiants pour `npm run sources:check` sans compte (sinon : -- --email, qui lit ceux des sources connectées) :
# FRANCE_TRAVAIL_CLIENT_ID=
# FRANCE_TRAVAIL_CLIENT_SECRET=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- Confidentialité (docs/RGPD.md) ---
# Jours de conservation du CV importé (fichier et texte brut) après validation du profil ; 0 = effacé dès la validation.
CV_SOURCE_RETENTION_DAYS=30

# --- Déploiement Docker Compose (docs/DEPLOIEMENT.md) ---
# Mot de passe de la base PostgreSQL du service « db » (DATABASE_URL est construite par compose.yaml).
POSTGRES_PASSWORD=

# --- Sauvegardes, planifiées par le worker (docs/OPERATIONS.md) ---
# Actives dès que BACKUP_DIR et BACKUP_PASSPHRASE sont renseignées (BACKUP_DIR est fixé par compose.yaml).
# BACKUP_DIR=/chemin/des/sauvegardes
# Phrase de passe des archives : à conserver aussi HORS du serveur, sans elle aucune restauration n'est possible.
BACKUP_PASSPHRASE=
# BACKUP_RETENTION_DAYS=30
# Heure de la sauvegarde quotidienne, dans le fuseau APP_TIME_ZONE (cron à 5 champs).
# BACKUP_CRON=15 3 * * *
# Copie hors site de chaque archive (rclone, remote défini par variables) vers un stockage objet d'une autre région :
# RCLONE_CONFIG_HORSSITE_TYPE=s3
# RCLONE_CONFIG_HORSSITE_PROVIDER=Scaleway
# RCLONE_CONFIG_HORSSITE_REGION=nl-ams
# RCLONE_CONFIG_HORSSITE_ENDPOINT=s3.nl-ams.scw.cloud
# RCLONE_CONFIG_HORSSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_HORSSITE_SECRET_ACCESS_KEY=
# BACKUP_COPY_COMMAND='rclone copyto "$1" horssite:jobpilot-sauvegardes/"$(basename "$1")"'
