# --- Base de données (PostgreSQL 16) ---
DATABASE_URL=postgres://postgres@localhost:5432/jobpilot
# Base utilisée par les tests d'intégration (vidée à chaque test)
DATABASE_URL_TEST=postgres://postgres@localhost:5432/jobpilot_test

# --- Développement en HTTP uniquement : autorise le cookie de session sans l'attribut Secure ---
# COOKIE_INSECURE=1

# --- Documents ---
# Dossier du stockage local (développement). En production : stockage S3 compatible.
STORAGE_DIR=.data/storage

# --- IA : fournisseurs (voir docs/DECISIONS/0006) ---
# Ordre d'essai. Par défaut : local, groq, cerebras, gemini, mistral, openrouter, anthropic.
# Un fournisseur n'est actif que si sa clé ET son modèle sont renseignés. Vérifier avec : npm run llm:check
# LLM_PROVIDERS=groq,openrouter,gemini

# Pour chaque fournisseur <P> (GROQ, OPENROUTER, GEMINI, MISTRAL, CEREBRAS, LOCAL, ANTHROPIC) :
#   <P>_API_KEY, <P>_MODEL (obligatoires ; aucun modèle par défaut : les modèles gratuits changent souvent)
#   <P>_RPM, <P>_RPD           limites par minute / par jour (0 = aucune) ; valeurs par défaut indicatives
#   <P>_ALLOW_PERSONAL_DATA    true pour autoriser l'envoi du CV et des candidatures (refusé par défaut, sauf LOCAL)
#   <P>_BASE_URL               remplace l'URL par défaut
#   <P>_JSON_MODE              json_schema (défaut, repli automatique) ou json_object
#   <P>_MAX_TOKENS             plafond de sortie (défaut 4096)
#   <P>_PRICE_INPUT_PER_MTOK / <P>_PRICE_OUTPUT_PER_MTOK   tarif USD par million de jetons (défaut 0 : gratuit)

# Groq — https://console.groq.com (exemple de modèle : à vérifier dans la console)
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter — https://openrouter.ai (modèles gratuits : identifiants se terminant par « :free »)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# deny : n'utiliser que des hébergeurs qui ne conservent pas les requêtes (peut exclure des modèles gratuits)
# OPENROUTER_DATA_COLLECTION=deny

# Google Gemini (offre gratuite : contenus utilisés pour améliorer les produits Google)
GEMINI_API_KEY=
GEMINI_MODEL=

# Mistral La Plateforme (offre Experiment : accord pour l'entraînement requis)
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Modèle local compatible OpenAI (Ollama, LM Studio) : les données restent sur ta machine
# LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=

# Anthropic Claude (payant)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Budget journalier des appels payants, en USD (les appels sont bloqués une fois atteint)
LLM_DAILY_BUDGET_USD=2
